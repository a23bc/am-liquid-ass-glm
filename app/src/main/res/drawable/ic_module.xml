<?xml version="1.0" encoding="utf-8"?>
<!--
    AMLiquidAss module icon — a stylized water droplet over a soft glass backdrop.
    Replaces the upstream AM-plus-plus "AM++" glyph.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Rounded square backdrop with a soft blue-to-cyan glass gradient -->
    <path android:pathData="M27,2 L81,2 C93.7,2 106,14.3 106,27 L106,81 C106,93.7 93.7,106 81,106 L27,106 C14.3,106 2,93.7 2,81 L2,27 C2,14.3 14.3,2 27,2 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="2"
                android:startY="2"
                android:endX="106"
                android:endY="106"
                android:startColor="#1E88E5"
                android:endColor="#80DEEA" />
        </aapt:attr>
    </path>

    <!-- Main droplet silhouette -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.92"
        android:pathData="M54,22 C54,22 32,46 32,66 C32,80.8 42,92 54,92 C66,92 76,80.8 76,66 C76,46 54,22 54,22 Z" />

    <!-- Specular highlight (the "glass" reflection) -->
    <path
        android:fillColor="#B3E5FC"
        android:fillAlpha="0.85"
        android:pathData="M44,52 C44,52 38,62 38,70 C38,76 41,80 45,80 C48,80 50,78 50,74 C50,66 44,52 44,52 Z" />

</vector>
